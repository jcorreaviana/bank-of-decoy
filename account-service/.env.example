KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SERVICE_NAME=account-service
LOG_LEVEL=INFO
PORT=8002
# URL do onboarding-service, para a chamada sincrona GET /v1/onboarding/{id}/internal
# (specs/business/05-account-post-sincrono.md, specs/business/10-criptografia-cpf.md).
ONBOARDING_SERVICE_URL=http://localhost:8001
# Chave simetrica Fernet para decifrar/cifrar CPF (specs/business/10-criptografia-cpf.md).
# Deve ser IGUAL a CPF_ENCRYPTION_KEY do onboarding-service. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CPF_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key
