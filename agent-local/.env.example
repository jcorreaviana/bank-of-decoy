AGENT_LOCAL_INTERVAL_SECONDS=300
AGENT_LOCAL_MODEL=claude-sonnet-5
AGENT_LOCAL_MAX_TURNS=50
AGENT_OPS_DATABASE_URL=postgresql://bank:bank@localhost:5432/agent_ops
REPO_URL=https://github.com/jcorreaviana/bank-of-decoy.git
REPO_CLONE_DIR=./workspace/bank-of-decoy
# Banco de teste descartavel usado para rodar a suite do servico afetado
# (TESTING=true e setado pelo proprio agent-local ao invocar pytest - nunca
# aponte para o banco persistente principal, specs/tech/testing.md).
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5433
# Webhook de entrada do Discord para notificacoes de eventos do agente
# (specs/business/20-notificacoes-discord-agentes.md). Sem valor real aqui -
# gere um em Configuracoes do canal > Integracoes > Webhooks no Discord.
DISCORD_WEBHOOK_URL=changeme-discord-webhook-url
