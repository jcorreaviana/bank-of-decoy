PREDICTIVE_AGENT_INTERVAL_SECONDS=300
PREDICTIVE_AGENT_MODEL=llama3.2:3b
LOG_LEVEL=INFO
PROMETHEUS_URL=http://localhost:9090
AGENT_OPS_DATABASE_URL=postgresql://bank:bank@localhost:5432/agent_ops
ONBOARDING_SERVICE_URL=http://localhost:8001
ACCOUNT_SERVICE_URL=http://localhost:8002
PIX_KEY_SERVICE_URL=http://localhost:8003
TRANSACTION_SERVICE_URL=http://localhost:8004
# Webhook de entrada do Discord para notificacoes de eventos do agente
# (specs/business/20-notificacoes-discord-agentes.md). Sem valor real aqui -
# gere um em Configuracoes do canal > Integracoes > Webhooks no Discord.
DISCORD_WEBHOOK_URL=changeme-discord-webhook-url
# Mesmo segredo usado pelos 4 microservicos e pelo chaos-orchestrator
# (issue #51/#53) - sem isso, chaos_status.is_chaos_enabled() cai para o
# mecanismo antigo (docker inspect na variavel de ambiente CHAOS_ENABLED),
# que nao reflete caos ativado via POST /internal/chaos/config (issue #57).
CHAOS_INTERNAL_TOKEN=changeme-chaos-internal-token
